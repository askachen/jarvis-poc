generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  passwordHash      String
  role              String              @default("user")
  createdAt         DateTime            @default(now())
  conversations     Conversation[]
  tasks             Task[]
  notifications     Notification[]
  outlookConnector  OutlookConnector?
  skills            Skill[]
  mcpServers        McpServer[]
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // "user" | "assistant"
  content        String
  files          Json?        // Array of file metadata
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  name      String
  prompt    String
  frequency String    // "hourly" | "daily_9am" | "weekly_mon_9am" | "custom"
  cronExpr  String
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs      TaskRun[]
}

model TaskRun {
  id            String         @id @default(cuid())
  taskId        String
  status        String         // "running" | "success" | "failed"
  result        String?        @db.Text
  error         String?
  startedAt     DateTime       @default(now())
  finishedAt    DateTime?
  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  taskRunId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskRun   TaskRun? @relation(fields: [taskRunId], references: [id])
}

model OutlookConnector {
  id           String    @id @default(cuid())
  userId       String    @unique
  connected    Boolean   @default(false)
  mockMode     Boolean   @default(true)
  displayEmail String?
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  tokenExpiry  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id           String   @id @default(cuid())
  name         String
  description  String?
  type         String   @default("user_upload")
  zipPath      String?
  skillContent String?  @db.Text
  isSystem     Boolean  @default(false)
  enabled      Boolean  @default(true)
  ownerId      String?
  owner        User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model McpServer {
  id          String   @id @default(cuid())
  name        String
  description String?
  command     String
  args        Json     @default("[]")
  env         Json     @default("{}")
  isSystem    Boolean  @default(true)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
